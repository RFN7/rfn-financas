# Backend de IA — variáveis de ambiente (configure no Railway → Variables)

# Sua chave da API da Claude (console.anthropic.com). NUNCA vai pro navegador.
ANTHROPIC_API_KEY=sk-ant-...

# ID do modelo atual — veja https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=claude-sonnet-4-5

# Domínios que podem chamar o backend (separados por vírgula).
# Coloque o do seu GitHub Pages + localhost para testar.
ALLOWED_ORIGINS=https://rfn7.github.io,http://localhost:8080
