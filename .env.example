# Config do front-end (esses valores do Firebase são PÚBLICOS por design;
# a segurança vem das firestore.rules). Copie do Console do Firebase e cole
# em firebase.js (const firebaseConfig).

FIREBASE_API_KEY=...
FIREBASE_AUTH_DOMAIN=SEU_PROJETO.firebaseapp.com
FIREBASE_PROJECT_ID=SEU_PROJETO
FIREBASE_STORAGE_BUCKET=SEU_PROJETO.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# URL do backend de IA depois de subir no Railway (cole em ai.js → AI_ENDPOINT).
AI_ENDPOINT=https://SEU-BACKEND.up.railway.app
